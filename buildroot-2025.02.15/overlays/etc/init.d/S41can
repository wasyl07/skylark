#!/bin/sh
# Bring up CAN interfaces at boot. Config: /etc/default/can

CAN_IFACES="can0"
CAN_BITRATE=1000000
CAN_TXQUEUELEN=100
CAN_RESTART_MS=100
[ -r /etc/default/can ] && . /etc/default/can

wait_iface() {
	i=0
	while [ ! -d "/sys/class/net/$1" ] && [ $i -lt 50 ]; do
		sleep 0.1; i=$((i + 1))
	done
	[ -d "/sys/class/net/$1" ]
}

start() {
	for ifc in $CAN_IFACES; do
		printf 'Starting %s (%s bit/s): ' "$ifc" "$CAN_BITRATE"
		if ! wait_iface "$ifc"; then echo "FAIL (no such device)"; continue; fi
		ip link set "$ifc" down 2>/dev/null
		if ip link set "$ifc" type can bitrate "$CAN_BITRATE" restart-ms "$CAN_RESTART_MS" &&
		   ip link set "$ifc" qlen "$CAN_TXQUEUELEN" &&
		   ip link set "$ifc" up; then
			echo "OK"
		else
			echo "FAIL"
		fi
	done
}

stop() {
	for ifc in $CAN_IFACES; do
		printf 'Stopping %s: ' "$ifc"
		ip link set "$ifc" down 2>/dev/null && echo "OK" || echo "FAIL"
	done
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
